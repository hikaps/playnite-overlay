<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#B3000000"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#EE1E2430"/>
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#232936"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#161B26"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2A3245"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3A4358"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3A4460"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#222A3A"/>
    <SolidColorBrush x:Key="ComboHighlightBackgroundBrush" Color="#2A3245"/>
    <SolidColorBrush x:Key="ComboSelectedBackgroundBrush" Color="#3A4460"/>
    <SolidColorBrush x:Key="RunningAppSelectedBackgroundBrush" Color="#303A50"/>
    <SolidColorBrush x:Key="RunningAppHoverBackgroundBrush" Color="#2E3748"/>
    <SolidColorBrush x:Key="RecentSelectedBackgroundBrush" Color="#2B3448"/>
    <SolidColorBrush x:Key="RecentHoverBackgroundBrush" Color="#262E3E"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F2F7"/>
    <SolidColorBrush x:Key="TextBrightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9B2C4"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A93A8"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#767F94"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#B8C0D0"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#55607A"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#00B4D8"/>
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#C8D0E0"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#00B4D8"/>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="#48CAE4"/>
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="#0096C7"/>
    <SolidColorBrush x:Key="AccentSwitchBrush" Color="#9D4EDD"/>
    <SolidColorBrush x:Key="AccentSwitchHoverBrush" Color="#C77DFF"/>
    <SolidColorBrush x:Key="AccentSwitchPressedBrush" Color="#7B2CBF"/>
    <SolidColorBrush x:Key="AccentDangerBrush" Color="#FF5A5F"/>
    <SolidColorBrush x:Key="AccentDangerHoverBrush" Color="#FF7A80"/>
    <SolidColorBrush x:Key="AccentDangerPressedBrush" Color="#D94348"/>
    <SolidColorBrush x:Key="AccentGoldBrush" Color="#FFD60A"/>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#B3000000"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#EE1A1A1A"/>
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#252525"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ComboHighlightBackgroundBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ComboSelectedBackgroundBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="RunningAppSelectedBackgroundBrush" Color="#353535"/>
    <SolidColorBrush x:Key="RunningAppHoverBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="RecentSelectedBackgroundBrush" Color="#303030"/>
    <SolidColorBrush x:Key="RecentHoverBackgroundBrush" Color="#2A2A2A"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="TextBrightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#888888"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#777777"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#BBBBBB"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#555555"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#CCCCCC"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#4A90E2"/>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="#5BA3F5"/>
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="#3A7BC8"/>
    <SolidColorBrush x:Key="AccentSwitchBrush" Color="#6A4FC8"/>
    <SolidColorBrush x:Key="AccentSwitchHoverBrush" Color="#7D5FDB"/>
    <SolidColorBrush x:Key="AccentSwitchPressedBrush" Color="#5A3FB5"/>
    <SolidColorBrush x:Key="AccentDangerBrush" Color="#D32F2F"/>
    <SolidColorBrush x:Key="AccentDangerHoverBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentDangerPressedBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="AccentGoldBrush" Color="#FFD700"/>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#B3000000"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F2141414"/>
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#191919"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#101010"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#242424"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#282828"/>
    <SolidColorBrush x:Key="ComboHighlightBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ComboSelectedBackgroundBrush" Color="#282828"/>
    <SolidColorBrush x:Key="RunningAppSelectedBackgroundBrush" Color="#222222"/>
    <SolidColorBrush x:Key="RunningAppHoverBackgroundBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="RecentSelectedBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="RecentHoverBackgroundBrush" Color="#242424"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextBrightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#757575"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#616161"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#111111"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#666666"/>

    <!-- Accents (monochrome) -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="AccentSwitchBrush" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="AccentSwitchHoverBrush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="AccentSwitchPressedBrush" Color="#BBBBBB"/>
    <SolidColorBrush x:Key="AccentDangerBrush" Color="#444444"/>
    <SolidColorBrush x:Key="AccentDangerHoverBrush" Color="#555555"/>
    <SolidColorBrush x:Key="AccentDangerPressedBrush" Color="#333333"/>
    <SolidColorBrush x:Key="AccentGoldBrush" Color="#AAAAAA"/>

</ResourceDictionary>
